PORT=4000
# 쉼표로 여러 개를 넣을 수 있다.
WEB_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/reread

# 액세스 토큰 서명 키. 배포에서는 반드시 바꾼다. 로그인의 state 서명에도
# 같은 키를 쓴다(oauth-session.service.ts).
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# 카카오·네이버·구글·Apple 넷으로만 로그인한다.
#
# 카카오·네이버·구글은 브라우저 동의 화면 → 이 서버의 콜백으로 들어온다
# (auth/oauth-session.service.ts). 콘솔에 등록하는 redirect URI는
# {PUBLIC_BASE_URL}/api/auth/{provider}/callback 이어야 한다.
#
# 배포한 뒤 이 서버의 공개 주소를 채운다. 비어 있으면 로그인 시작이 막힌다
# (로컬에서만 켜 둘 때는 비워 둬도 된다 — 그때는 카카오·네이버·구글 로그인이
# 안 되고 Apple만 된다).
PUBLIC_BASE_URL=
# 로그인이 끝나고 앱으로 돌아올 딥링크의 허용 스킴 — 쉼표로 여러 개.
# open redirect를 막으려고 이 목록에 없는 returnUrl은 거절한다.
# 빌드된 앱은 reread://, Expo Go로 테스트할 때는 exp://도 추가한다.
OAUTH_RETURN_URL_SCHEMES=reread://

KAKAO_CLIENT_ID=
# 카카오는 '보안' 탭에서 켰을 때만 필요하다.
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 구글은 iOS 앱용 클라이언트와 따로다 — Google Cloud Console에서
# "OAuth 클라이언트 ID" 만들 때 애플리케이션 유형을 반드시 "웹 애플리케이션"으로
# 고른다(시크릿이 있는 것만 서버에서 코드를 토큰으로 바꿀 수 있다).
# 승인된 리디렉션 URI에 {PUBLIC_BASE_URL}/api/auth/google/callback을 등록한다.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# 질문(ask). 키가 없으면 물어본 문장은 전부 대기로 남는다 — 담는 일은 실패하지 않는다.
ANTHROPIC_API_KEY=
# 기본값은 claude-sonnet-5. 더 나은 답이 필요하면 claude-opus-5로 올린다.
ASK_MODEL=claude-sonnet-5
# 한 달에 답을 받을 수 있는 질문 수. 다 써도 문장은 그대로 담긴다.
ASK_MONTHLY_LIMIT=30

# 줄을 문장으로 잇기만 하는 일이라 더 싼 모델로 내려도 된다(claude-haiku-4-5).
SPLIT_MODEL=claude-sonnet-5

# 호스팅의 프록시를 몇 단 믿을지(0 이상의 정수). 호출 횟수 제한이 진짜 클라이언트 IP를
# 읽는 데 쓴다. 비워 두면 운영(NODE_ENV=production)은 1, 개발은 0이다.
#  - 프록시 뒤인데 0이면: 로그인 전 요청이 전부 한 IP로 보여서 한도가 서버 전체에 걸린다.
#  - 프록시가 없는데 1 이상이면: X-Forwarded-For를 지어 보내서 한도를 피할 수 있다.
# 부팅 로그의 '프록시 신뢰 단 수'로 지금 값을 확인한다.
TRUST_PROXY=

# 개발용 로그인. 소셜 로그인 앱이 등록되기 전까지만 켠다.
# POST /api/dev/login. NODE_ENV=production이면 켜져 있어도 거부되고, 검증이 끝나면
# src/auth/dev-login.controller.ts와 함께 지운다.
ALLOW_DEV_LOGIN=false

# 책 검색. 검색어에 한글이 있으면 카카오 책 검색(KAKAO_CLIENT_ID의 REST 키를 그대로 쓴다),
# 그 밖의 언어는 Open Library(키 없음)로 찾는다.
# 넣으면 한글이 아닌 검색에서 구글 북스를 먼저 부른다. Google Cloud Console에서 무료(일 1000회).
# 키 없는 구글 요청은 쿼터를 같은 네트워크와 나눠 써서 거의 늘 429라 부르지 않는다.
GOOGLE_BOOKS_API_KEY=
# Open Library에 밝힐 연락처 메일. 넣으면 서버 전체 한도가 초당 1건에서 3건으로 오른다.
OPEN_LIBRARY_CONTACT=

# Apple 로그인 — 앱 번들 id (identityToken 의 aud)
APPLE_CLIENT_ID=
