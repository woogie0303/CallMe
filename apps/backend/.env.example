PORT=4000
# 쉼표로 여러 개를 넣을 수 있다.
WEB_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/reread

# 액세스 토큰 서명 키. 배포에서는 반드시 바꾼다.
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# 로그인은 이 셋으로만 들어온다. 앱마다 등록한 redirect URI가 요청의
# redirectUri와 정확히 같아야 한다.
KAKAO_CLIENT_ID=
# 카카오는 '보안' 탭에서 켰을 때만 필요하다.
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 질문(ask). 키가 없으면 물어본 문장은 전부 대기로 남는다 — 담는 일은 실패하지 않는다.
ANTHROPIC_API_KEY=
# 기본값은 claude-sonnet-5. 더 나은 답이 필요하면 claude-opus-5로 올린다.
ASK_MODEL=claude-sonnet-5
# 한 달에 답을 받을 수 있는 질문 수. 다 써도 문장은 그대로 담긴다.
ASK_MONTHLY_LIMIT=30

# 줄을 문장으로 잇기만 하는 일이라 더 싼 모델로 내려도 된다(claude-haiku-4-5).
SPLIT_MODEL=claude-sonnet-5

# 개발용 로그인. 소셜 로그인 앱이 등록되기 전까지만 켠다.
# POST /api/dev/login. NODE_ENV=production이면 켜져 있어도 거부되고, 검증이 끝나면
# src/auth/dev-login.controller.ts와 함께 지운다.
ALLOW_DEV_LOGIN=false

# 책 검색(구글 북스). 키가 없어도 동작하지만 쿼터를 다른 네트워크와 나눠 쓴다 —
# Google Cloud Console에서 무료로 발급받아 넣으면 이 앱만의 쿼터(일 1000회)가 된다.
GOOGLE_BOOKS_API_KEY=

# Apple 로그인 — 앱 번들 id (identityToken 의 aud)
APPLE_CLIENT_ID=
