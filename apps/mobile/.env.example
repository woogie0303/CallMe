# 앱이 부를 API 주소. 맥의 LAN IP로 못 박는 걸 권한다 —
# `ipconfig getifaddr en0`로 확인해서 채운다.
#
# 비워두면 Expo 개발 서버 호스트(hostUri)에서 자동으로 추측하는데, Metro가
# 터널 모드로 뜨면 hostUri가 Metro 자체의 터널 주소로 잡혀서 거기엔 4000번
# (이 백엔드)이 없다 — 그 상태에서는 "Could not connect to the server"로
# 조용히 실패한다. LAN 모드로만 뜬다는 확신이 없으면 여기 채워두는 편이 낫다.
EXPO_PUBLIC_API_URL=http://192.168.0.10:4000/api

# 개발 빌드에서 로그인 화면을 건너뛰고 개발용 독자로 바로 들어간다.
# 실제 소셜 로그인을 시험할 때만 false로 둔다.
EXPO_PUBLIC_DEV_AUTOLOGIN=true
