{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://callme-d60c.onrender.com/api",
        "EXPO_PUBLIC_APPLE_SIGN_IN": "true",
        "EXPO_PUBLIC_DEV_AUTOLOGIN": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
